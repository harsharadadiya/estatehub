# =====================================================================
# EstateHub API settings
# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to Git.
# =====================================================================

# "development" on your computer, "production" on Render
NODE_ENV=development
PORT=5000

# ---------- Database (MongoDB Atlas) ----------
# Atlas: Database -> Connect -> Drivers. Put the database name (estatehub) after ".net/"
# Example: mongodb+srv://myuser:MyPassword@cluster0.abcde.mongodb.net/estatehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/estatehub

# ---------- Login tokens ----------
# Long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replacesdwheduwhedbwhefbhwgebfhbwehfbwefbgwvefgvwe
JWT_EXPIRES_IN=7d

# ---------- Frontend address(es) allowed to call this API (CORS) ----------
# Several addresses: separate with commas. No slash at the end.
CLIENT_URL=http://localhost:5173

# ---------- Email (SMTP) for password reset and booking emails ----------
# Works with Gmail (App Password), Brevo, Mailtrap, SendGrid SMTP, etc.
# If SMTP_HOST is empty in development, emails are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EstateHub <no-reply@example.com>"

# ---------- Image storage (ImageKit CDN) ----------
# ImageKit dashboard -> Developer options -> API keys -> Private key
# If empty, images are saved in server/uploads (fine for local testing only).
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/estatehub/properties

# ---------- Optional bonus: AI Property Hub ----------
# Turn the AI search on or off without changing code.
AI_HUB_ENABLED=false
# Claude API key from https://console.anthropic.com (used to read and rank listings).
# Without it, the hub still works with simple rule-based ranking.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Optional server-side Firecrawl key. Users can also bring their own key from the AI Hub page.
FIRECRAWL_API_KEY=
