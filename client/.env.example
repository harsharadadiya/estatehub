# =====================================================================
# EstateHub website settings
# Copy to ".env" (local) or add them in Vercel -> Project -> Settings -> Environment Variables.
# Everything starting with VITE_ is visible in the browser, so never put secrets here.
# =====================================================================

# Address of the API.
#   Local development: leave as /api (Vite forwards it to http://localhost:5000)
#   Production: https://YOUR-API.onrender.com/api
VITE_API_URL=/api

# Public address of this website (used for SEO tags and robots.txt)
VITE_SITE_URL=http://localhost:5173

# Optional bonus: show the AI Property Hub page (true/false).
# The API must also have AI_HUB_ENABLED=true.
VITE_ENABLE_AI_HUB=false

# Development only: where Vite forwards /api calls (default http://localhost:5000)
# VITE_DEV_API_PROXY=http://localhost:5000
